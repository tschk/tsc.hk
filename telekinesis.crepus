google-fonts "Chivo Mono"

div min-h-screen bg-zinc-950 text-zinc-300 p-6 sm:p-12 text-sm leading-relaxed
  div max-w-2xl flex flex-col gap-8
    div
      div text-zinc-100 text-lg font-semibold tracking-wide #tk-heading
        "telekinesis"
    div text-zinc-400 leading-6
      "AI coding agent CLI + TUI. Powered by the rotary (rx4) harness engine and crepuscularity-tui."
    div text-zinc-500 leading-6
      "minimal, fast, typed event boundary. rotary owns the loop. telekinesis owns the pi protocol compat layer."
    div
      div text-zinc-100 font-medium mt-4
        "BUILD"
      div flex flex-col gap-1 mt-2
        div text-zinc-400
          "cd ui/tui && cargo build --release"
        div text-zinc-500
          "binary: ui/tui/target/release/tk"
    div
      div text-zinc-100 font-medium mt-4
        "RUN"
      div flex flex-col gap-1 mt-2
        div text-zinc-400
          "tk login grok"
        div text-zinc-400
          "tk"
        div text-zinc-400
          "XAI_API_KEY=... tk"
    div
      div text-zinc-100 font-medium mt-4
        "SOURCE"
      div flex flex-col gap-1 mt-2
        a con href="https://github.com/semitechnological/telekinesis"
          span name
            "GitHub"
          span desc
            " — https://github.com/semitechnological/telekinesis"
        a con href="https://github.com/tschk/rotary"
          span name
            "rotary"
          span desc
            " — https://github.com/tschk/rotary"
        a con href="https://tsc.hk"
          span name
            "tsc.hk"
          span desc
            " — the software company of hong kong"
    div text-zinc-600 text-xs mt-12
      "MPL-2.0. site built with crepuscularity + moonshine"

.con no-underline transition-all duration-200 ease-in-out group text-zinc-400 hover:text-zinc-100 decoration-zinc-700 underline-offset-4 visited:text-zinc-400
.name text-zinc-100 group-hover:text-white transition-colors duration-200
.desc text-zinc-500 group-hover:text-zinc-400 transition-colors duration-200
